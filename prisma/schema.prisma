// Kebda Zaman — Prisma schema
// PHASE 1: database foundation. Models the P0 entities required by
// BACKEND_IMPLEMENTATION_PLAN.md §2 (Database Design Plan) and §14 (Phase 1).
//
// Scope note: `PromoCode` is included as a minimal stub (fields copied verbatim
// from plan §2.15) solely because Order.appliedPromoId / Cart.appliedPromoId are
// hard-specified FKs on the two core Phase-1 entities (§2.9, §2.11) — this is the
// "+ P1 stubs where cheap" case anticipated in §14. No promo business logic exists
// here. Address, Favorite, LoyaltyAccount, NotificationCampaign are deferred to
// their respective phases: no Phase-1-required entity holds a hard FK to any of
// them (Order's delivery address is a JSONB snapshot, not a live FK).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserRole {
  CUSTOMER
  ADMIN
  CASHIER
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  OUT_FOR_DELIVERY
  READY_FOR_PICKUP
  DELIVERED
  PICKED_UP
  CANCELLED
}

enum DeliveryMethod {
  DELIVERY
  PICKUP
}

enum PaymentMethod {
  CASH
  CARD
  WALLET
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum DiscountType {
  PERCENT
  FIXED
}

enum OrderItemCustomizationKind {
  VARIANT
  ADDON
}

enum DevicePlatform {
  ANDROID
  IOS
  WEB
  MACOS
  WINDOWS
}

enum CampaignTargetAudience {
  ALL
  CUSTOMERS
  GUESTS
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  SENT
  FAILED
}

enum MenuItemBadge {
  BESTSELLER
  TOP_RATED
}

// ---------------------------------------------------------------------------
// Identity & sessions (plan §2.1, §2.2)
// ---------------------------------------------------------------------------

/// Account identity, auth, role. Plan §2.1.
model User {
  id                  String    @id @default(uuid()) @db.Uuid
  // Nullable to allow guest users; uniqueness among active accounts is enforced
  // by a partial unique index added via raw SQL in the migration (Prisma's schema
  // DSL cannot express `WHERE deletedAt IS NULL AND email IS NOT NULL`).
  email               String?
  passwordHash        String?
  // External identity linkage for Firebase-authenticated sign-in (Google via
  // Firebase Auth). Null for accounts that have never signed in with Google.
  // Nullable + unique so at most one user can ever claim a given Firebase uid.
  firebaseUid         String?   @unique
  fullName            String
  phone               String?
  avatarUrl           String?
  role                UserRole  @default(CUSTOMER)
  isGuest             Boolean   @default(false)
  locale              String    @default("en")
  onboardingCompleted Boolean   @default(false)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  deletedAt           DateTime?

  refreshTokens    RefreshToken[]
  orders           Order[]
  deviceTokens     DeviceToken[]
  /// One active cart per user (Cart.userId is unique) — guest carts have userId = null.
  cart             Cart?
  statusChanges    OrderStatusHistory[]
  createdCampaigns NotificationCampaign[]
  addresses        Address[]
  favorites        Favorite[]
  loyaltyAccount   LoyaltyAccount?

  @@index([email])
  @@index([role])
}

/// Refresh-token rotation + multi-device sessions + logout/revocation. Plan §2.2.
model RefreshToken {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @db.Uuid
  tokenHash         String    @unique
  familyId          String    @db.Uuid
  userAgent         String?
  ip                String?
  expiresAt         DateTime
  revokedAt         DateTime?
  replacedByTokenId String?
  createdAt         DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
}

// ---------------------------------------------------------------------------
// Catalog (plan §2.4 - §2.8)
// ---------------------------------------------------------------------------

/// Plan §2.4.
model Category {
  id           String    @id @default(uuid()) @db.Uuid
  nameAr       String
  nameEn       String
  iconUrl      String?
  displayOrder Int       @default(0)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  menuItems MenuItem[]

  @@index([displayOrder])
  @@index([isActive])
}

/// Plan §2.5. Referenced by OrderItem only via a soft (non-FK) snapshot reference.
model MenuItem {
  id             String         @id @default(uuid()) @db.Uuid
  categoryId     String         @db.Uuid
  nameAr         String
  nameEn         String
  descriptionAr  String         @db.Text
  descriptionEn  String         @db.Text
  basePrice      Decimal        @db.Decimal(10, 2)
  // Optional kcal value shown on the menu. No calculation/derivation — admin-entered only.
  calories       Int?
  // Previous/original display price for a discounted item; basePrice remains the
  // actual charged price. No promotions engine or discount math reads this in this phase.
  compareAtPrice Decimal?       @db.Decimal(10, 2)
  imageUrl       String?
  isAvailable    Boolean        @default(true)
  isPopular      Boolean        @default(false)
  // Manually set by the Admin; independent from isPopular. Null = no badge. Never inferred.
  badge          MenuItemBadge?
  displayOrder   Int?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  deletedAt      DateTime?

  category           Category                 @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  variants           ItemVariant[]
  addonGroups        AddonGroup[]
  cartItems          CartItem[]
  favorites          Favorite[]
  recommendations    MenuItemRecommendation[] @relation("MenuItemRecommendations")
  recommendedInLists MenuItemRecommendation[] @relation("RecommendedMenuItem")

  @@index([categoryId])
  @@index([isAvailable])
  @@index([isPopular])
}

/// "Often Ordered With" — admin-curated recommendation from one MenuItem to
/// another. Recommendations point to MenuItem only (no variant targeting), and
/// carry no pricing/business logic in this phase — displayOrder just preserves
/// the admin-curated ordering.
model MenuItemRecommendation {
  id                    String   @id @default(uuid()) @db.Uuid
  menuItemId            String   @db.Uuid
  recommendedMenuItemId String   @db.Uuid
  displayOrder          Int      @default(0)
  createdAt             DateTime @default(now())

  menuItem            MenuItem @relation("MenuItemRecommendations", fields: [menuItemId], references: [id], onDelete: Cascade)
  recommendedMenuItem MenuItem @relation("RecommendedMenuItem", fields: [recommendedMenuItemId], references: [id], onDelete: Cascade)

  @@unique([menuItemId, recommendedMenuItemId])
  @@index([menuItemId, displayOrder])
  @@index([recommendedMenuItemId])
}

/// Size/variant with a price delta. Plan §2.6.
model ItemVariant {
  id           String   @id @default(uuid()) @db.Uuid
  menuItemId   String   @db.Uuid
  nameAr       String
  nameEn       String
  priceDelta   Decimal  @default(0) @db.Decimal(10, 2)
  isDefault    Boolean  @default(false)
  displayOrder Int?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  menuItem  MenuItem   @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  cartItems CartItem[]

  @@index([menuItemId])
}

/// Plan §2.7. minSelect/maxSelect invariants are enforced at the pricing/checkout
/// service layer (not at the DB), per the plan's explicit note.
model AddonGroup {
  id           String   @id @default(uuid()) @db.Uuid
  menuItemId   String   @db.Uuid
  titleAr      String
  titleEn      String
  isRequired   Boolean  @default(false)
  minSelect    Int      @default(0)
  maxSelect    Int      @default(1)
  displayOrder Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  addons   Addon[]

  @@index([menuItemId])
}

/// Plan §2.8.
model Addon {
  id           String   @id @default(uuid()) @db.Uuid
  addonGroupId String   @db.Uuid
  nameAr       String
  nameEn       String
  price        Decimal  @default(0) @db.Decimal(10, 2)
  isAvailable  Boolean  @default(true)
  displayOrder Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  addonGroup     AddonGroup      @relation(fields: [addonGroupId], references: [id], onDelete: Cascade)
  cartItemAddons CartItemAddon[]

  @@index([addonGroupId])
}

// ---------------------------------------------------------------------------
// Promotions — minimal stub (see scope note at top of file). Plan §2.15.
// ---------------------------------------------------------------------------

model PromoCode {
  id                String       @id @default(uuid()) @db.Uuid
  code              String       @unique
  discountType      DiscountType
  value             Decimal      @db.Decimal(10, 2)
  minOrderAmount    Decimal?     @db.Decimal(10, 2)
  maxDiscountAmount Decimal?     @db.Decimal(10, 2)
  maxUsage          Int?
  usageCount        Int          @default(0)
  perUserLimit      Int?
  startsAt          DateTime?
  expiresAt         DateTime?
  isActive          Boolean      @default(true)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  deletedAt         DateTime?

  carts  Cart[]
  orders Order[]
}

// ---------------------------------------------------------------------------
// Cart (plan §2.9, §2.10)
// ---------------------------------------------------------------------------

/// Server-side persistent cart, one active cart per user. Plan §2.9.
/// deliveryFee/taxRate are intentionally NOT stored here — they are read from
/// RestaurantSettings at pricing time so the client can never influence them.
model Cart {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String?  @unique @db.Uuid
  appliedPromoId String?  @db.Uuid
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user         User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  appliedPromo PromoCode? @relation(fields: [appliedPromoId], references: [id], onDelete: SetNull)
  items        CartItem[]
}

/// A configured cart line (item + variant + addons + qty). Plan §2.10.
/// unitPrice/totalPrice are computed server-side on read, never stored here.
model CartItem {
  id                  String   @id @default(uuid()) @db.Uuid
  cartId              String   @db.Uuid
  menuItemId          String   @db.Uuid
  selectedVariantId   String?  @db.Uuid
  quantity            Int
  specialInstructions String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  cart            Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  menuItem        MenuItem        @relation(fields: [menuItemId], references: [id], onDelete: Restrict)
  selectedVariant ItemVariant?    @relation(fields: [selectedVariantId], references: [id], onDelete: SetNull)
  addons          CartItemAddon[]

  @@index([cartId])
  @@index([menuItemId])
}

/// Join table for a CartItem's selected addons. Plan §2.10.
model CartItemAddon {
  id         String @id @default(uuid()) @db.Uuid
  cartItemId String @db.Uuid
  addonId    String @db.Uuid

  cartItem CartItem @relation(fields: [cartItemId], references: [id], onDelete: Cascade)
  addon    Addon    @relation(fields: [addonId], references: [id], onDelete: Restrict)

  @@unique([cartItemId, addonId])
  @@index([cartItemId])
  @@index([addonId])
}

// ---------------------------------------------------------------------------
// Orders (plan §2.11 - §2.13, §2.21)
// ---------------------------------------------------------------------------

/// Plan §2.11. Never hard-deleted.
model Order {
  id                         String         @id @default(uuid()) @db.Uuid
  orderNumber                String         @unique
  userId                     String         @db.Uuid
  status                     OrderStatus    @default(PENDING)
  subtotal                   Decimal        @db.Decimal(10, 2)
  deliveryFee                Decimal        @db.Decimal(10, 2)
  tax                        Decimal        @db.Decimal(10, 2)
  discount                   Decimal        @db.Decimal(10, 2)
  totalAmount                Decimal        @db.Decimal(10, 2)
  deliveryMethod             DeliveryMethod
  paymentMethod              PaymentMethod
  paymentStatus              PaymentStatus  @default(PENDING)
  appliedPromoId             String?        @db.Uuid
  promoCodeSnapshot          String?
  // Address snapshot at checkout time — decouples the order from later edits/
  // deletes of the customer's saved addresses (Address entity is Phase 2+).
  deliveryAddressJson        Json
  // DEPRECATED (superseded by the distance-pricing snapshot columns below) —
  // always null on orders placed after the distance-pricing migration. Kept,
  // unused by any active code path, only so orders placed under the old
  // zone-based system keep reading back correctly. `deliveryFee` above
  // already holds the authoritative fee snapshot for those old orders (the
  // zone's fee at order time, or 0 for pickup); these two columns snapshot
  // only the zone's bilingual name so history stays readable if the zone is
  // later renamed/deactivated. Mirrors the promoCodeSnapshot convention above.
  deliveryZoneId             String?        @db.Uuid
  deliveryZoneNameArSnapshot String?
  deliveryZoneNameEnSnapshot String?
  // Distance-based delivery pricing snapshot — set for DELIVERY orders only
  // (null for PICKUP and for orders placed before this migration).
  // `deliveryTierId` is a soft reference (plain UUID, no FK — same
  // convention as OrderItem.menuItemId) so a later admin edit/deactivation
  // of the tier never changes what an existing order reports; the min/max
  // snapshot columns are the actual authoritative record of which tier
  // applied. `deliveryFee` above remains the authoritative fee amount.
  deliveryDistanceMeters     Int?
  deliveryDurationSeconds    Int?
  deliveryTierId             String?        @db.Uuid
  deliveryTierMinKmSnapshot  Decimal?       @db.Decimal(5, 2)
  deliveryTierMaxKmSnapshot  Decimal?       @db.Decimal(5, 2)
  estimatedDeliveryTime      DateTime?
  createdAt                  DateTime       @default(now())
  updatedAt                  DateTime       @updatedAt
  cancelledAt                DateTime?
  cancelReason               String?

  user          User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  appliedPromo  PromoCode?           @relation(fields: [appliedPromoId], references: [id], onDelete: SetNull)
  deliveryZone  DeliveryZone?        @relation(fields: [deliveryZoneId], references: [id], onDelete: SetNull)
  items         OrderItem[]
  statusHistory OrderStatusHistory[]
  payments      Payment[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([deliveryZoneId])
}

/// Plan §2.12. Snapshot row — no updatedAt (immutable once created).
/// menuItemId is a soft reference (plain UUID, not an FK) so catalog deletes
/// never orphan order history.
model OrderItem {
  id                  String   @id @default(uuid()) @db.Uuid
  orderId             String   @db.Uuid
  menuItemId          String?  @db.Uuid
  quantity            Int
  unitPrice           Decimal  @db.Decimal(10, 2)
  lineTotal           Decimal  @db.Decimal(10, 2)
  specialInstructions String?
  nameArSnapshot      String
  nameEnSnapshot      String
  imageUrlSnapshot    String?
  createdAt           DateTime @default(now())

  order          Order                    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customizations OrderItemCustomization[]

  @@index([orderId])
  @@index([menuItemId])
}

/// Immutable snapshot of a chosen variant/addon at order time. Plan §2.13.
/// refId is a soft reference (plain UUID, not an FK) to the original variant/addon.
model OrderItemCustomization {
  id             String                     @id @default(uuid()) @db.Uuid
  orderItemId    String                     @db.Uuid
  kind           OrderItemCustomizationKind
  refId          String?                    @db.Uuid
  nameArSnapshot String
  nameEnSnapshot String
  priceSnapshot  Decimal                    @db.Decimal(10, 2)
  createdAt      DateTime                   @default(now())

  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@index([orderItemId])
}

/// Powers the customer tracking timeline + admin audit trail. Plan §2.21.
model OrderStatusHistory {
  id              String       @id @default(uuid()) @db.Uuid
  orderId         String       @db.Uuid
  fromStatus      OrderStatus?
  toStatus        OrderStatus
  changedByUserId String?      @db.Uuid
  note            String?
  createdAt       DateTime     @default(now())

  order         Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  changedByUser User? @relation(fields: [changedByUserId], references: [id], onDelete: SetNull)

  @@index([orderId])
}

// ---------------------------------------------------------------------------
// Payments (plan §2.14)
// ---------------------------------------------------------------------------

/// Gateway-agnostic payment record. Plan §2.14. No gateway integration in Phase 1.
model Payment {
  id             String        @id @default(uuid()) @db.Uuid
  orderId        String        @db.Uuid
  method         PaymentMethod
  status         PaymentStatus @default(PENDING)
  amount         Decimal       @db.Decimal(10, 2)
  currency       String
  provider       String?
  providerRef    String?
  idempotencyKey String        @unique
  rawWebhookJson Json?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([providerRef])
}

// ---------------------------------------------------------------------------
// Device tokens (plan §2.17)
// ---------------------------------------------------------------------------

/// FCM token registry — multi-device, guest-tolerant. Plan §2.17.
model DeviceToken {
  id         String         @id @default(uuid()) @db.Uuid
  userId     String?        @db.Uuid
  token      String         @unique
  platform   DevicePlatform
  lastSeenAt DateTime
  isActive   Boolean        @default(true)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([isActive])
}

// ---------------------------------------------------------------------------
// Restaurant settings (plan §2.19)
// ---------------------------------------------------------------------------

/// Single authoritative source for delivery fee, tax rate, min order. Plan §2.19.
/// Singleton enforced via the unique `singleton` marker column (always `true`),
/// which Postgres allows at most one row to satisfy.
///
/// Phase 8: restaurantName/addressText (single-language) were split into
/// Ar/En pairs to match every other bilingual model in this schema
/// (Category, MenuItem, ...) — the migration backfills both from the prior
/// single value, so no data is lost. `workingHours` keeps its column/JSON
/// key name but its shape changed from a single `{open,close}` pair to a
/// 7-entry per-day array (see WorkingHoursDayDto) — the migration backfills
/// every day from the prior single pair with `isOpen: true`, preserving the
/// restaurant's prior effective hours. `deliveryFee`/`minOrderAmount` remain
/// the store-wide defaults/floor (still enforced for every order regardless
/// of fulfillment type); for DELIVERY orders the authoritative per-order fee
/// now comes from distance-based pricing (see DeliveryDistanceTier /
/// DeliveryPricingService) — `deliveryFee` is no longer read for DELIVERY
/// pricing, but is kept since it still gates PICKUP's store-wide minimum
/// and remains a reasonable fallback/default.
///
/// `restaurantLatitude`/`restaurantLongitude` (distance-pricing migration):
/// the single authoritative origin used for every Google Routes distance
/// calculation — never hardcoded in a service. NOT NULL: checkout for
/// DELIVERY orders cannot function without a real origin. Decimal(10,7)
/// (7 fractional digits, not Address's 6) deliberately — the approved
/// production coordinates (21.5705641 / 39.1681808) carry 7 fractional
/// digits and must round-trip exactly, not get silently truncated.
model RestaurantSettings {
  id                  String   @id @default(uuid()) @db.Uuid
  singleton           Boolean  @unique @default(true)
  restaurantNameAr    String
  restaurantNameEn    String
  logoUrl             String?
  phone               String
  addressAr           String
  addressEn           String
  taxRatePercent      Decimal  @db.Decimal(10, 2)
  deliveryFee         Decimal  @db.Decimal(10, 2)
  minOrderAmount      Decimal  @db.Decimal(10, 2)
  currency            String
  /// 7-entry array: [{ dayOfWeek: 0-6, isOpen: boolean, openTime: "HH:MM"|null, closeTime: "HH:MM"|null }].
  /// Informational/display only — see `acceptingOrders` for the actual
  /// checkout gate; hours do not themselves open/close order acceptance.
  workingHours        Json
  /// IANA timezone the working-hours times above are expressed in. Never
  /// inferred from the server's local timezone. Default is this
  /// restaurant's actual location (Jeddah, Saudi Arabia).
  timezone            String   @default("Asia/Riyadh")
  /// Manual checkout gate (plan Phase 8). When false, checkout rejects new
  /// orders with RESTAURANT_NOT_ACCEPTING_ORDERS regardless of workingHours —
  /// this project does not auto-derive acceptance from hours.
  acceptingOrders     Boolean  @default(true)
  closedMessageAr     String?
  closedMessageEn     String?
  isMaintenanceMode   Boolean  @default(false)
  restaurantLatitude  Decimal  @db.Decimal(10, 7)
  restaurantLongitude Decimal  @db.Decimal(10, 7)
  updatedAt           DateTime @updatedAt
}

/// DEPRECATED — superseded by DeliveryDistanceTier / DeliveryPricingService.
/// No longer read by any active code path (checkout, pricing, admin APIs are
/// all gone); the table and its FK from Order are kept only so historical
/// orders placed before the distance-pricing migration keep reading back
/// correctly via Order.deliveryZoneId / deliveryZoneName{Ar,En}Snapshot.
/// Do not add new writers of this model.
model DeliveryZone {
  id           String    @id @default(uuid()) @db.Uuid
  nameAr       String
  nameEn       String
  deliveryFee  Decimal   @db.Decimal(10, 2)
  minimumOrder Decimal   @db.Decimal(10, 2)
  isActive     Boolean   @default(true)
  sortOrder    Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  orders Order[]

  @@index([isActive, sortOrder])
}

/// ADMIN-managed distance-based delivery pricing tier — the authoritative
/// source for a DELIVERY order's fee, keyed by actual driving distance
/// (Google Routes API `distanceMeters`) from RestaurantSettings' coordinates
/// to the customer's delivery pin. Interval semantics: `minDistanceKm` is
/// inclusive; `maxDistanceKm` is exclusive, EXCEPT for the active tier with
/// the greatest `maxDistanceKm` (the "final" tier), which is inclusive on
/// its max — see DeliveryPricingService.matchTier, which resolves this off
/// whole-meter integers (never float km comparisons) to avoid boundary
/// errors. No soft-delete: tiers are never referenced by FK (Order only
/// keeps a soft `deliveryTierId` + a min/max snapshot), so `isActive` is
/// sufficient for admin deactivation.
model DeliveryDistanceTier {
  id            String   @id @default(uuid()) @db.Uuid
  minDistanceKm Decimal  @db.Decimal(5, 2)
  maxDistanceKm Decimal  @db.Decimal(5, 2)
  deliveryFee   Decimal  @db.Decimal(10, 2)
  minimumOrder  Decimal  @db.Decimal(10, 2) @default(0)
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([isActive, sortOrder])
}

// ---------------------------------------------------------------------------
// Notification campaigns (plan §2.18, §9.4/§9.5). Phase 7C.
// ---------------------------------------------------------------------------

/// Admin push notification campaign. `type` is a plain string matching one of
/// the 14 NotificationType values (validated at the DTO layer, not the DB).
model NotificationCampaign {
  id               String                 @id @default(uuid()) @db.Uuid
  campaignName     String
  title            String
  body             String
  imageUrl         String?
  type             String
  targetAudience   CampaignTargetAudience @default(ALL)
  destinationRoute String?
  entityId         String?
  status           CampaignStatus         @default(DRAFT)
  isScheduled      Boolean                @default(false)
  scheduledAt      DateTime?
  sentAt           DateTime?
  totalRecipients  Int                    @default(0)
  deliveredCount   Int                    @default(0)
  openedCount      Int                    @default(0)
  clickRate        Decimal                @default(0) @db.Decimal(5, 2)
  createdByUserId  String                 @db.Uuid
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  createdBy User @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([status])
  @@index([scheduledAt])
}

// ---------------------------------------------------------------------------
// Addresses, Favorites, Loyalty (plan §2.3, §2.16, §2.20). Phase 9.
// ---------------------------------------------------------------------------

/// Saved delivery address. Plan §2.3. "At most one isDefault=true per user" is
/// enforced in AddressesService, not at the DB level (Prisma can't express a
/// partial unique index in the schema DSL).
model Address {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  title     String
  street    String
  building  String
  floor     String?
  apartment String?
  city      String
  notes     String?
  latitude  Decimal? @db.Decimal(9, 6)
  longitude Decimal? @db.Decimal(9, 6)
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Plan §2.20. One row per (user, menuItem) — the unique constraint is the
/// duplicate-favorite guard.
model Favorite {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  menuItemId String   @db.Uuid
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@unique([userId, menuItemId])
  @@index([userId])
}

/// Plan §2.16. One account per user, created lazily on first read/earn.
model LoyaltyAccount {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @unique @db.Uuid
  pointsBalance Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions LoyaltyTransaction[]
}

/// Plan §2.16. Immutable ledger — balance is always derived by replaying/summing
/// deltas conceptually, though `LoyaltyAccount.pointsBalance` caches the running
/// total for fast reads (kept in sync transactionally with each insert here).
/// `@@unique([orderId, reason])` is the idempotency guard against double-awarding
/// points for the same order — this doubles as the guard against double-redeeming
/// a checkout-time reward for the same order (orderId is null for non-order
/// transactions, i.e. manual redemptions via POST /me/loyalty/redeem, and Postgres
/// treats distinct NULLs as non-conflicting, so those are unaffected).
model LoyaltyTransaction {
  id        String   @id @default(uuid()) @db.Uuid
  accountId String   @db.Uuid
  delta     Int
  reason    String
  orderId   String?  @db.Uuid
  // Which LOYALTY_REWARDS catalog entry this REDEMPTION row corresponds to.
  // Null for ORDER_EARNED rows (earning isn't tied to a reward) and for any
  // pre-existing REDEMPTION row created before this column existed.
  rewardId  String?
  createdAt DateTime @default(now())

  account LoyaltyAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([orderId, reason])
  @@index([accountId])
}

// ---------------------------------------------------------------------------
// Admin Notification Center. Sprint 1.
// ---------------------------------------------------------------------------

/// Internal, admin-facing event feed (e.g. "new order placed") — distinct from
/// `NotificationCampaign` (customer-facing FCM pushes triggered manually by an
/// admin). This is written automatically by the backend as a side effect of
/// domain events; FCM delivery to admin devices is a later sprint and will read
/// from this same table rather than replacing it.
///
/// `type` is a plain string (not a DB enum), same convention as
/// `NotificationCampaign.type` — new notification types never require a
/// migration, only a new string constant validated at the call site.
/// `orderId`/`customerId`/`customerName`/`orderNumber`/`totalAmount` are all
/// nullable and unrelated to any live FK (soft references, same pattern as
/// `OrderItem`'s snapshot fields) because future notification types (e.g. a
/// low-stock alert) won't have an order or customer to attach at all.
model AdminNotification {
  id           String   @id @default(uuid()) @db.Uuid
  type         String   @default("NEW_ORDER")
  title        String
  body         String
  orderId      String?  @db.Uuid
  customerId   String?  @db.Uuid
  customerName String?
  orderNumber  String?
  totalAmount  Decimal? @db.Decimal(10, 2)
  isRead       Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([isRead])
  @@index([createdAt])
}
