# ---------------------------------------------------------------------------
# Kebda Zaman Backend — Phase 0 environment template
# Copy this file to `.env` and fill in real values. NEVER commit the real .env.
# All environment-specific values (hosts, IPs, secrets) live here — never in code.
# ---------------------------------------------------------------------------

# Runtime environment: development | production | test
NODE_ENV=development

# Port the API listens on (bound to 0.0.0.0 inside the container).
API_PORT=3000

# Log level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Comma-separated list of allowed CORS origins (exact origins, no wildcards in prod).
# Example: the Flutter web admin panel origin(s). Leave empty to disable browser CORS.
CORS_ORIGINS=http://localhost:8080

# --- PostgreSQL (used by docker-compose to provision the db service) ---
POSTGRES_USER=CHANGE_ME_USER
POSTGRES_PASSWORD=CHANGE_ME_PASSWORD
POSTGRES_DB=kebda_zaman

# Host port to publish the compose Postgres on (container port stays 5432).
# Override if 5432 is already used by a local Postgres on your machine.
DB_HOST_PORT=5432

# --- Prisma connection string ---
# When running the API on the HOST (outside Docker) against the compose DB, use localhost:DB_HOST_PORT.
# The `api` container overrides this to reach host `db` on 5432 (see docker-compose.yml) — no IPs hardcoded.
DATABASE_URL=postgresql://CHANGE_ME_USER:CHANGE_ME_PASSWORD@localhost:5432/kebda_zaman?schema=public

# --- Auth / JWT (Phase 2) ---
# Long random secret for signing access tokens. Generate with e.g. `openssl rand -hex 32`.
# NEVER reuse this placeholder — it must be a real secret in every real environment.
JWT_ACCESS_SECRET=CHANGE_ME_RANDOM_SECRET_AT_LEAST_32_CHARS
# Access token lifetime (short-lived; jsonwebtoken duration string).
JWT_ACCESS_TTL=15m
# Refresh token lifetime in days (opaque token, stored hashed in RefreshToken).
JWT_REFRESH_TTL_DAYS=30

# --- Rate limiting (global default; stricter auth-route limits are hardcoded) ---
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=100

# --- Brute-force login lockout ---
BRUTE_FORCE_MAX_ATTEMPTS=5
BRUTE_FORCE_LOCK_MINUTES=15

# --- File uploads (admin image uploads: menu items, categories, promos, ...) ---
# Directory (relative to process cwd, or absolute) where uploaded files are written.
# Inside Docker this is backed by the `uploads` volume (see docker-compose.yml) so
# files survive container restarts/rebuilds.
UPLOAD_DIR=./uploads
# Public origin clients use to reach this API — used to build the absolute
# imageUrl returned by the upload endpoint. `localhost` only resolves to "this
# device" on the machine running the server — every other client (a phone, an
# emulator, a browser on another machine) will fail to load the returned
# image URLs if this is left as localhost. Set it to:
#   - a LAN IP reachable from other devices on the same network, e.g.
#     http://192.168.1.51:3000, for local multi-device testing
#   - the real https://api.<domain> origin in production
PUBLIC_BASE_URL=http://localhost:3000
UPLOAD_MAX_FILE_SIZE_MB=5

# --- Firebase Admin SDK / FCM (Phase 6) ---
# Exact Firebase project id (per audit: "keebda-zaman", double-e).
FIREBASE_PROJECT_ID=keebda-zaman
# Set ONE of the two below. Leave BOTH unset to disable FCM sending (safe
# no-op) — the app boots normally without them, e.g. in local/test envs.
# Never commit the real service-account JSON or paste its contents here.
#
# Option A: path to a service-account JSON file mounted as a secret (preferred).
# FIREBASE_SERVICE_ACCOUNT_PATH=/run/secrets/firebase-service-account.json
#
# Option B: the service-account JSON inline as a single-line string.
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
